#!/usr/bin/env sh
# Closes audit finding I-07. Block commits that contain secrets matching
# the gitleaks ruleset.
#
# Requires gitleaks installed locally:
#   macOS:  brew install gitleaks
#   Linux:  see https://github.com/gitleaks/gitleaks#installation
#
# If gitleaks is not installed the hook prints a warning and allows the
# commit through so day-one cloners do not get blocked. Install it when
# you can.

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "[pre-commit] gitleaks not installed — skipping secret scan."
  echo "             install with: brew install gitleaks"
  exit 0
fi

gitleaks protect --staged --redact --no-banner --verbose
